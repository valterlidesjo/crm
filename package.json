{
  "name": "@crm/root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/web",
    "packages/functions"
  ],
  "scripts": {
    "dev": "npm run dev -w @crm/web",
    "build": "npm run build -w @crm/shared && npm run build -w @crm/web",
    "lint": "npm run lint -w @crm/web",
    "migrate:allowed-emails": "node scripts/migrate-allowed-emails.mjs",
    "migrate:split-variants": "node scripts/migrate-split-variants.mjs",
    "backfill:product-type": "node scripts/backfill-product-type.mjs",
    "sync:skus": "node scripts/sync-skus.mjs",
    "sync:cdon": "node scripts/sync-cdon.mjs",
    "verify:sync": "node scripts/verify-sync.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
